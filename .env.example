# ============================================
# TRADING MODE (paper|live)
# ============================================
TRADING_MODE=paper

# ============================================
# DEEP THINKING LLM (Complex Analysis)
# ============================================
DEEP_THINK_PROVIDER=openai
DEEP_THINK_MODEL=gpt-4-turbo
DEEP_THINK_API_KEY=sk-...
DEEP_THINK_API_BASE=https://api.openai.com/v1
DEEP_THINK_TEMPERATURE=0.5
DEEP_THINK_MAX_TOKENS=4000

# ============================================
# QUICK THINKING LLM (Fast Decisions)
# ============================================
QUICK_THINK_PROVIDER=openai
QUICK_THINK_MODEL=gpt-3.5-turbo
QUICK_THINK_API_KEY=sk-...
QUICK_THINK_TEMPERATURE=0.7
QUICK_THINK_MAX_TOKENS=2000

# Alternative LLM Providers
# CLAUDE_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
# DEEPSEEK_API_KEY=sk-...
# OLLAMA_API_BASE=http://localhost:11434
# VLLM_API_BASE=http://localhost:8000

# ============================================
# BROKER CONFIGURATION (Alpaca)
# ============================================
BROKER_PROVIDER=alpaca
BROKER_API_KEY=YOUR_ALPACA_KEY
BROKER_SECRET_KEY=YOUR_ALPACA_SECRET
BROKER_ACCOUNT_ID=
BROKER_BASE_URL=https://paper-api.alpaca.markets

# ============================================
# RISK MANAGEMENT
# ============================================
DAILY_LOSS_LIMIT=0.02
PER_TRADE_RISK=0.01
MIN_REWARD_RISK_RATIO=3.0
ATR_MULTIPLIER=1.5
KILL_SWITCH_ENABLED=true
KILL_SWITCH_LOSS_THRESHOLD=0.02

# ============================================
# DATA SOURCES
# ============================================
PRIMARY_DATA_SOURCE=yfinance
BACKUP_DATA_SOURCE=yfinance
TWELVE_DATA_API_KEY=
ALPACA_API_KEY=

# ============================================
# AGENT CONFIGURATION
# ============================================
FUNDAMENTALS_AGENT_ENABLED=true
SENTIMENT_AGENT_ENABLED=true
NEWS_AGENT_ENABLED=true
TECHNICAL_AGENT_ENABLED=true
DEBATE_ENGINE_ENABLED=true
DEBATE_ROUNDS=3
CONFIDENCE_THRESHOLD=0.65

# ============================================
# CHECKPOINT & PERSISTENCE
# ============================================
CHECKPOINT_ENABLED=true
CHECKPOINT_SAVE_INTERVAL=300
CHECKPOINT_STORAGE_PATH=./data/checkpoints
CHECKPOINT_RETENTION_DAYS=30

# ============================================
# AUTO-TUNING (Hyperparameter Optimization)
# ============================================
AUTO_TUNE_ENABLED=true
AUTO_TUNE_INTERVAL_DAYS=30
OPTUNA_TRIALS=100

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FILE=./logs/trading_system.log

# ============================================
# OPTIONAL: HISTORICAL DATA ACCESS
# ============================================
OANDA_API_TOKEN=
OANDA_ACCOUNT_ENVIRONMENT=practice
